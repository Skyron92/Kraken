@page "/"
@using Kraken.Components.Models
@using Category = Kraken.Components.Category

<div style="padding: 5em;">
    <MudGrid>
        <MudItem xs="12">
            <CategoryButton @bind-IsOpen="Categories.IsEditing"/>
        </MudItem>
        <MudItem xs="10">
            <MudExpansionPanels MultiExpansion="true" Outlined="true">
            
                @if (_isLoading)
                {
                    <MudProgressCircular Indeterminate Size="Size.Small"/>
                }
                else
                { 
                    @foreach (var cat in Categories.Values)
                    {
                        <Category CategoryData="cat" OnEdit="Categories.EditCategory"/>
                    }
                }
            </MudExpansionPanels>
        </MudItem>
    </MudGrid>
    @if (Categories.IsEditing) {
        <CategoryForm Category="Categories.CategoryEditing" OnValidate="Categories.Validate" IsOpenChanged="Categories.CancelEditing"/>
    }
</div>

@code
{
    public Categories Categories { get; } = new();
    bool _isLoading;
    
    protected override async Task OnInitializedAsync() {
        _isLoading = true;
        await Categories.GetCategories();
        _isLoading = false;
    }
}
