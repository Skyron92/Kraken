@using System.Globalization
<MudStack Row="true">
    <MudExpansionPanel Text="@($"{Name} : {RemainingAmount.ToString("C", new CultureInfo("fr-FR"))}")">
        @if (_isLoading)
        {
            <MudProgressCircular Indeterminate Size="Size.Small"/>
        }
        else
        {
            @foreach (var op in Operations)
            {
                <Operation Data="op"/>
            } 
        }
    </MudExpansionPanel>
    <MudIconButton Icon="@Icons.Material.Outlined.MoreVert" OnClick="Edit"/>
</MudStack>

@code
{
    bool _isLoading;
    protected override async Task OnInitializedAsync() {
        _isLoading = true;
        await CategoryData.GetOperations();
        _isLoading = false;
    }
}
