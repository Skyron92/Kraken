<MudStack Row="true">
    <MudExpansionPanel Text="@($"{_name} : ${RemainingAmount}")">
        @foreach (var op in _operations)
        {
            <Operation Data="op"/>
        }
        <MudText Typo="Typo.h6">@_name</MudText>
    </MudExpansionPanel>
    <MudIconButton Icon="@Icons.Material.Outlined.MoreVert" OnClick="Edit"/>
</MudStack>